{
  "name": "@cotecna/stencil-components",
  "version": "4.0.0",
  "description": "Cotecna Stencil Components",
  "author": "Cotecna",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "Stencil",
    "WebComponents"
  ],
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "es2015": "dist/esm/index.mjs",
  "es2017": "dist/esm/index.mjs",
  "es2024": "dist/esm/index.mjs",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/cotecna-stencil-components/cotecna-stencil-components.esm.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/Cotecna-Inspection/cotecna-stencil.git"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "release": "stencil build --ci --prod",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil test --spec --e2e",
    "test.watch": "stencil test --spec --e2e --watchAll",
    "generate": "stencil generate"
  },
  "dependencies": {
    "@capacitor/app": "7.0.1",
    "@capacitor/app-launcher": "7.0.1",
    "@capacitor/camera": "7.0.1",
    "@capacitor/clipboard": "7.0.2",
    "@capacitor/core": "7.4.2",
    "@ionic/pwa-elements": "^3.3.0",
    "@stencil/core": "^4.38.3",
    "@stencil/sass": "^3.0.4",
    "cordova-plugin-camera": "^6.0.0",
    "cordova-plugin-ml-text": "^3.1.0",
    "cordova-plugin-network-information": "^3.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "7.4.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.10.1",
    "jest": "^29.7.0",
    "jest-cli": "^29.7.0",
    "puppeteer": "^22.15.0",
    "typescript": "~5.4"
  },
  "optionalDependencies": {
    "@capacitor/android": "7.4.2",
    "@capacitor/ios": "7.4.2"
  }
}
